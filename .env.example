YOUCAM_API_KEY=
# CHECK_GAP=168h   # 2m for demos
# DATA_DIR=./data-local
# DB_PATH=./data-local/skinverdict.db   # or "json"
# Agent: "claude" shells out to the Claude Code CLI (`claude -p`, needs `claude` logged in on this machine); "rules" is deterministic
# AGENT=claude
# CLAUDE_BIN=/usr/local/bin/claude
# CLAUDE_ARGS=--model sonnet
# ADMIN_TOKEN=          # enables POST /api/admin/checkin-all with "Authorization: Bearer <token>"; unset = route 404s
# SCANS_PER_HOUR=60     # server-wide cap on YouCam scans (9 units each); 0 = unlimited
